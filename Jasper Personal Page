            font-size: 2.5rem;
            color: var(--primary-color);
            letter-spacing: -0.025em;
        }

        .subtitle {
            font-size: 1.1rem;
            color: var(--muted-color);
            margin: 0;
        }

        section {
            background: var(--card-bg);
            padding: 1.75rem 2rem;
            margin-bottom: 1.5rem;
            border-radius: 8px;
            border: 1px solid var(--border-color);
        }

        h2 {
            font-size: 1.35rem;
            color: var(--primary-color);
            border-bottom: 2px solid #eff6ff;
            padding-bottom: 0.5rem;
            margin-top: 0;
            margin-bottom: 1.25rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        ul {
            margin: 0;
            padding-left: 1.25rem;
        }

        li {
            margin-bottom: 0.5rem;
        }

        .pub-item, .exp-item, .edu-item {
            margin-bottom: 1.25rem;
        }

        .pub-item:last-child, .exp-item:last-child, .edu-item:last-child {
            margin-bottom: 0;
        }

        .pub-title {
            font-weight: 600;
        }

        .pub-authors {
            color: var(--text-color);
        }

        .pub-journal {
            font-style: italic;
            color: var(--muted-color);
        }

        .badge-container {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            margin-top: 0.35rem;
        }

        .badge {
            background-color: #eff6ff;
            color: var(--accent-color);
            font-size: 0.78rem;
            font-weight: 600;
            padding: 0.2rem 0.55rem;
            border-radius: 4px;
            border: 1px solid #bfdbfe;
        }

        .item-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            flex-wrap: wrap;
        }

        .item-title {
            font-weight: 600;
        }

        .item-date {
            color: var(--muted-color);
            font-size: 0.9rem;
        }

        .item-sub {
            color: var(--muted-color);
            font-size: 0.95rem;
        }

        a {
            color: var(--accent-color);
            text-decoration: none;
        }

        a:hover {
            text-decoration: underline;
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        @media (max-width: 640px) {
            .grid-2 {
                grid-template-columns: 1fr;
            }
            .container {
                padding: 1rem;
            }
            section {
                padding: 1.25rem;
            }
        }
